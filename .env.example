# ==========================================
# JanaoBangla — Environment Variables Example
# Real .env file create korte ei file copy koro:
#   cp .env.example .env
# Tahole actual credentials fill in koro
# ==========================================

# ---- SERVER CONFIG ----
# Backend server kon port e chalbe
PORT=5000
NODE_ENV=development

# ---- MySQL DATABASE ----
# MySQL database connection details
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=janao_bangla_db

# ---- JWT (JSON Web Token) ----
# JWT secret key — strong random string dite hobe
# Generate korte: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_minimum_64_characters_long
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_key_minimum_64_characters
JWT_REFRESH_EXPIRES_IN=30d

# ---- EMAIL (Gmail SMTP via Nodemailer) ----
# Gmail e "App Password" enable korte hobe (2FA on rakho)
# https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASSWORD=your_gmail_app_password_16_chars
EMAIL_FROM_NAME=JanaoBangla
EMAIL_FROM_ADDRESS=your_gmail_address@gmail.com

# ---- SMS SERVICE (MiMSMS Bangladesh SMS Gateway V2) ----
# MiMSMS API credentials (https://mimsms.com > Utility > Developer)
SMS_PROVIDER=mimsms
MIMSMS_API_KEY=your_mimsms_api_key
MIMSMS_USERNAME=your_mimsms_login_email@example.com
MIMSMS_SENDER_NAME=JanaoBangla
MIMSMS_SMS_TYPE=T

# ---- GOOGLE GEMINI AI ----
# AI features er jonno Google Gemini API key
# https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ---- FILE UPLOAD ----
# Uploaded files kon folder e store hobe
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# ---- FRONTEND URL (CORS) ----
# Frontend kon URL theke backend access korbe
FRONTEND_URL=http://localhost:5173

# ---- RATE LIMITING ----
# API rate limit configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
