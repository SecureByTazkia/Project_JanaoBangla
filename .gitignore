# ==========================================
# JanaoBangla — .gitignore
# Ei file ta Git ke bolche ki ki track korbe na
# ==========================================

# Node modules — dependency folders ignore kora hocche
node_modules/
frontend/node_modules/
backend/node_modules/

# Environment files — secret credentials kabhi commit hobe na
.env
frontend/.env
backend/.env

# Build output — production build files ignore kora hocche
frontend/dist/
frontend/build/

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Editor/IDE folders
.vscode/
.idea/
*.swp
*.swo

# Uploaded files — user-uploaded media server e thakbe, git e na
backend/uploads/

# Temporary files
*.tmp
*.temp

# Coverage reports
coverage/

# Cache
.cache/
.parcel-cache/

# Nested stray clones
Project_JanaoBangla/
